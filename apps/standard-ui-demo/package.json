{
  "name": "@no-comply/standard-ui-demo",
  "version": "0.0.11",
  "description": "Demo application showcasing the Standard UI component library.",
  "keywords": [
    "web-app",
    "demo",
    "solidjs",
    "ui",
    "components",
    "component-library"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/no-comply.git",
    "directory": "apps/standard-ui-demo"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "start": "vite build && vite preview",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@no-comply/meta": "*",
    "@no-comply/solid-accessibility": "*",
    "@no-comply/solid-composables": "*",
    "@no-comply/solid-contexts": "*",
    "@no-comply/solid-dev-tools": "*",
    "@no-comply/solid-primitives": "*",
    "@no-comply/standard-ui": "*",
    "@purrception/lang-ts": "0.1.0",
    "@purrpose/client-babel": "0.0.11",
    "@purrpose/client-babel-preset-solidjs": "0.0.12",
    "@purrpose/solid-shiki-service": "0.0.13",
    "@purrtrait/client-tsx": "0.0.11",
    "@purrtrait/code-renderer": "0.0.11",
    "@purrtrait/lang-ts": "0.0.11",
    "@purrtrait/solid-code": "0.0.12",
    "@purrtrait/view-tsx": "0.0.11",
    "@solid-primitives/intersection-observer": "2.2.4",
    "@solid-primitives/mutation-observer": "1.2.3",
    "@solid-primitives/resize-observer": "2.1.5",
    "@solid-primitives/storage": "4.3.4",
    "@solidjs/router": "0.16.1",
    "babel-plugin-jsx-dom-expressions": "0.40.7",
    "dotenv": "17.4.2",
    "lucide-solid": "1.61.0",
    "prettier": "3.9.10",
    "shiki": "4.3.0",
    "solid-js": "1.9.17",
    "solid-services": "4.3.2",
    "solidjs-use": "2.3.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "csstype": "3.2.3",
    "jsdom": "30.0.1",
    "vite-plugin-solid": "2.11.14",
    "vite-plugin-solid-svg": "0.8.1"
  }
}
