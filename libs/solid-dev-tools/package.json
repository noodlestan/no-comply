{
  "name": "@no-comply/solid-dev-tools",
  "version": "0.0.11",
  "description": "Instrumentation and debug tools for [No Comply] applications and libraries",
  "keywords": [
    "library",
    "dev-tools",
    "debugging",
    "solidjs",
    "ui",
    "components",
    "component-library"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/no-comply.git",
    "directory": "libs/solid-dev-tools"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite build --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@no-comply/solid-contexts": "*",
    "@no-comply/solid-accessibility": "*",
    "@no-comply/solid-primitives": "*",
    "@no-comply/solid-composables": "*",
    "@no-comply/standard-ui": "*"
  },
  "peerDependencies": {
    "lucide-solid": "^1.61.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "vite-plugin-solid": "2.11.14",
    "vite-plugin-solid-svg": "0.8.1"
  }
}
