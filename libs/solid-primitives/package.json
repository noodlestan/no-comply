{
  "name": "@no-comply/solid-primitives",
  "version": "0.0.11",
  "description": "Basic primitives and types for SolidJS applications and component libraries.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andrezero/no-comply.git",
    "directory": "libs/solid-primitives"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "src",
    "LICENSE-MIT"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "extract": "tsx scripts/extract.ts",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "peerDependencies": {
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@no-comply/meta-extract": "0.0.11",
    "@purrception/source-fs": "^0.0.11",
    "tsx": "4.22.4",
    "vite-plugin-solid": "2.11.12",
    "vite-plugin-solid-svg": "0.8.1"
  }
}
