{
  "name": "@no-comply/solid-accessibility",
  "version": "0.0.11",
  "description": "Aria types, primitives, and utils for SolidJS applications and component libraries",
  "keywords": [
    "library",
    "accessibility",
    "primitives",
    "solidjs",
    "ui",
    "components",
    "component-library"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/no-comply.git",
    "directory": "libs/solid-accessibility"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "scss",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite build --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "extract": "tsx scripts/extract.ts",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@no-comply/solid-primitives": "*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@no-comply/meta-extract": "0.0.11",
    "@purrception/source-fs": "0.1.0",
    "tsx": "4.23.15",
    "vite-plugin-solid": "2.11.14",
    "vite-plugin-solid-svg": "0.8.1"
  }
}
