{
  "name": "@no-comply/meta",
  "version": "0.0.11",
  "description": "Purrception types, services, and helpers for the [no-comply] project.",
  "keywords": [
    "library",
    "metadata",
    "services",
    "purrception",
    "solidjs",
    "ui",
    "components",
    "component-library"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/no-comply.git",
    "directory": "libs/meta"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@purrception/lang-ts": "0.1.0",
    "@purrception/primitives": "0.1.0"
  },
  "peerDependencies": {},
  "devDependencies": {}
}
