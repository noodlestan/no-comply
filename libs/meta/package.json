{
  "name": "@no-comply/meta",
  "version": "0.0.11",
  "description": "Purrception types, services, and helpers for the [no-comply] project.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/andrezero/no-comply.git",
    "directory": "libs/meta"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "src",
    "scss",
    "LICENSE-MIT"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@purrception/lang-ts": "^0.0.11",
    "@purrception/primitives": "^0.0.11"
  },
  "peerDependencies": {},
  "devDependencies": {}
}
