{
  "name": "@no-comply/mybin",
  "version": "0.0.1",
  "description": "Workspace tools.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/andrezero/no-comply.git",
    "directory": "cli/mybin"
  },
  "type": "module",
  "module": "dist/esm/index.mjs",
  "main": "dist/cjs/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "types": "./dist/esm/index.d.ts",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT"
  ],
  "bin": {
    "mybin": "node dist/esm/index.mjs"
  },
  "scripts": {
    "dev": "esbuild-cli-watch",
    "build:clean": "rm -rf dist",
    "build:types:esm": "tsc --project tsconfig.esm.json",
    "build:types:cjs": "tsc --project tsconfig.cjs.json",
    "build": "esbuild-cli",
    "test": "echo none yet",
    "test:watch": "vitest",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "run": "node dist/esm/index.mjs",
    "ci": "npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@purrception/primitives": "git+ssh://git@github.com/noodlestan/purrception.git#main",
    "@purrception/source-fs": "git+ssh://git@github.com/noodlestan/purrception.git#main",
    "@purrception/lang-ts-extract": "git+ssh://git@github.com/noodlestan/purrception.git#main"
  },
  "peerDependencies": {
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@noodlestan/esbuild": "^0.0.11",
    "@types/node": "25.9.3"
  }
}
