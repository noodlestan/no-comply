{
  "name": "@no-comply/meta-extract",
  "version": "0.0.11",
  "description": "Purrception extraction tools for the [no-comply] project.",
  "keywords": [
    "cli",
    "metadata",
    "extraction",
    "purrception",
    "solidjs",
    "ui",
    "components",
    "component-library"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/no-comply.git",
    "directory": "cli/meta-extract"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@no-comply/meta": "*",
    "@purrception/primitives": "0.1.0",
    "@purrception/lang-ts-extract": "0.1.0",
    "@purrception/source-fs": "0.1.1"
  },
  "devDependencies": {}
}
